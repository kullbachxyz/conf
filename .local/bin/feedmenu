#!/bin/sh

sfeed_config="${XDG_CONFIG_HOME:-$HOME/.config}/sfeed/sfeedrc"
feed_dir="${XDG_DATA_HOME:-$HOME/.local/share}/sfeed/feeds"
browser="${BROWSER:-xdg-open}"

mkdir -p "$feed_dir" || exit 1

sfeed_update "$sfeed_config" >/dev/null 2>&1

choice="$(
	for f in "$feed_dir"/*; do
		[ -f "$f" ] || continue
		feed="$(basename "$f")"

		awk -F '\t' -v feed="$feed" '
		{
			timestamp = $1
			title = $2
			link = $3

			if (title == "")
				title = link

			print timestamp "\t" feed " | " title " [" link "]"
		}
		' "$f"
	done |
	sort -rn -k1,1 |
	cut -f2- |
	dmenu -i -l 20 -p "feeds:"
)"

[ -z "$choice" ] && exit 0

url="$(printf '%s\n' "$choice" | sed 's/.*\[\(.*\)\]$/\1/')"

[ -n "$url" ] && "$browser" "$url"
