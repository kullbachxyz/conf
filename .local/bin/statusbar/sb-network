#!/bin/sh

btn="${BLOCK_BUTTON:-$BUTTON}"
if [ -n "$btn" ]; then
	case "$btn" in
		1|2) setsid -f st -e wlctl ;;
	esac
fi

iface=$(ip route show default 2>/dev/null | awk 'NR==1{print $5}')
if [ -n "$iface" ]; then
	if [ -d "/sys/class/net/$iface/wireless" ]; then
		printf '󰖩'
	else
		printf '󰈀'
	fi
else
	printf '󰖪'
fi
