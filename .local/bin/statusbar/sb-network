#!/bin/sh

# wlan/ethernet icon (mac-style, icon only)
cache="/tmp/statusbar-network"

btn="${BLOCK_BUTTON:-$BUTTON}"
if [ -n "$btn" ]; then
	case "$btn" in
		1|2) setsid -f st -e wlctl ;;
		3) notify-send "Network module" "Icon by state: Wi-Fi / Ethernet / offline.
- Left click: wlctl" ;;
	esac
fi

route=$(ip route show default 2>/dev/null)
if [ $? -ne 0 ]; then
	[ -r "$cache" ] && cat "$cache"
	exit 0
fi
iface=$(printf '%s\n' "$route" | awk 'NR==1{print $5}')
if [ -n "$iface" ]; then
	if [ -d "/sys/class/net/$iface/wireless" ]; then icon=''; else icon=''; fi
else
	icon='󰖪'
fi
printf '%s\n' "$icon" > "$cache"
printf '%s\n' "$icon"
