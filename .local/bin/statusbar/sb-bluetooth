#!/bin/sh

# bluetooth icon: off / on / connected

btn="${BLOCK_BUTTON:-$BUTTON}"
if [ -n "$btn" ]; then
	case "$btn" in
		1|2) setsid -f "$TERMINAL" -e bluetui ;;
		3) notify-send "Bluetooth" "Left click opens bluetoothctl." ;;
	esac
fi

if [ "$(timeout 2 bluetoothctl show 2>/dev/null | grep -c 'Powered: yes')" -eq 0 ]; then
	icon='󰂲'
elif timeout 2 bluetoothctl devices Connected 2>/dev/null | grep -q .; then
	icon='󰂱'
else
	icon='󰂯'
fi
printf '%s\n' "$icon"
