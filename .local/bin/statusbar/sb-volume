#!/bin/sh

# Prints the current volume or a mute icon if muted.

btn="${BLOCK_BUTTON:-$BUTTON}"
if [ -n "$btn" ]; then
	case "$btn" in
		1|2)
			setsid st -e pulsemixer
			pkill -RTMIN+10 dwmblocks
			exit
			;;
	esac
fi

vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)" || vol=""

# If muted, print a mute icon and exit.
[ "$vol" != "${vol%\[MUTED\]}" ] && echo "󰖁" && exit

if [ -z "$vol" ]; then
	echo "󰖁"
	exit
fi

vol="${vol#Volume: }"

split() {
	# For ommiting the . without calling and external program.
	IFS=$2
	set -- $1
	printf '%s' "$@"
}

vol="$(printf "%.0f" "$(split "$vol" ".")")"

case 1 in
	$((vol >= 70)) ) icon="󰕾" ;;
	$((vol >= 30)) ) icon="󰖀" ;;
	$((vol >= 1)) ) icon="󰕿" ;;
	* ) echo "󰖁" && exit ;;
esac

echo "$icon"
