#!/bin/sh

# Volume with a Nerd-Font speaker icon (mute icon if muted).

btn="${BLOCK_BUTTON:-$BUTTON}"
if [ -n "$btn" ]; then
	case "$btn" in
		1|2)
			setsid st -e pulsemixer
			pkill -RTMIN+10 dwmblocks
			exit
			;;
		3) notify-send "VOL module" "Shows current volume level.
- Left click opens pulsemixer." ;;
	esac
fi

vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)" || vol=""

if [ -z "$vol" ] || [ "$vol" != "${vol%\[MUTED\]}" ]; then
	printf '\n'
	exit
fi

vol="${vol#Volume: }"

split() {
	IFS=$2
	set -- $1
	printf '%s' "$@"
}

vol="$(printf "%.0f" "$(split "$vol" ".")")"

[ "$vol" -ge 50 ] && icon='' || icon=''
printf '%s %s\n' "$icon" "$vol"
