#!/bin/sh

# Volume as a level-dependent speaker icon only. ALWAYS prints an icon
# (button actions fall through to the print) so the block is never empty.

btn="${BLOCK_BUTTON:-$BUTTON}"
case "$btn" in
	1|2) setsid -f st -e pulsemixer ;;
	3) notify-send "Volume module" "Speaker icon by level: mute / low / medium / high.
- Left click: pulsemixer
- Scroll: volume +/- 5%" ;;
	4) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ ;;
	5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
esac

vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)" || vol=""

if [ -z "$vol" ] || [ "$vol" != "${vol%\[MUTED\]}" ]; then
	printf '󰸈\n'
	exit
fi

vol="${vol#Volume: }"
split() { IFS=$2; set -- $1; printf '%s' "$@"; }
vol="$(printf '%.0f' "$(split "$vol" ".")")"

if   [ "$vol" -ge 67 ]; then icon='󰕾'
elif [ "$vol" -ge 34 ]; then icon='󰖀'
elif [ "$vol" -ge 1 ];  then icon='󰕿'
else icon='󰝟'; fi
printf '%s\n' "$icon"
