#!/bin/sh
LOCKFILE=/tmp/mailsync-running
LASTRUN="${XDG_DATA_HOME:-$HOME/.local/share}/mailsync-lastrun"
LASTRUN_PREV=/tmp/mailsync-lastrun-prev
MAILDIR="${XDG_DATA_HOME:-$HOME/.local/share}/mail"

pgrep mbsync >/dev/null && exit

SILENT=0
[ "$1" = "-s" ] && SILENT=1

# DBUS nur für nicht-interaktive Shells setzen (z.B. cron), nie überschreiben
[ -z "$DBUS_SESSION_BUS_ADDRESS" ] && export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus

# Alten LASTRUN-Zeitstempel sichern, dann LASTRUN vor dem Sync aktualisieren
# damit neu heruntergeladene Dateien garantiert neuer als LASTRUN sind
touch -r "$LASTRUN" "$LASTRUN_PREV" 2>/dev/null || touch -d @0 "$LASTRUN_PREV"
touch "$LOCKFILE" "$LASTRUN"
pkill -RTMIN+14 dwmblocks 2>/dev/null

[ "$SILENT" -eq 0 ] && notify-send "📬 mailsync" "Sync läuft..." -i mail-message

if [ "$SILENT" -eq 1 ]; then
    mbsync -a > /dev/null 2>&1 && notmuch new --quiet
    RESULT=$?
else
    mbsync -a && notmuch new
    RESULT=$?
fi

if [ "$RESULT" -eq 0 ]; then
    [ "$SILENT" -eq 0 ] && notify-send "📬 mailsync" "Sync fertig" -i mail-message

    new=$(find "$MAILDIR" \( -path "*/[Ii][Nn][Bb][Oo][Xx]/new/*" -o -path "*/[Ii][Nn][Bb][Oo][Xx]/cur/*" \) \
        -type f -newer "$LASTRUN_PREV" 2>/dev/null)
    newcount=$(echo "$new" | sed '/^\s*$/d' | wc -l)

    if [ "$newcount" -gt 5 ]; then
        notify-send "📬 Neue Mails" "$newcount neue Nachrichten" -i mail-message
    elif [ "$newcount" -gt 0 ]; then
        echo "$new" | while IFS= read -r file; do
            subject=$(awk '/^Subject: / && ++n == 1,/^.*: / && ++i == 2' "$file" | head -n-1 |
                perl -CS -MEncode -ne 'print decode("MIME-Header", $_)' |
                sed 's/^Subject: //' | tr -d '\n\t')
            from=$(sed -n "/^From:/ s|From: *||p" "$file" |
                perl -CS -MEncode -ne 'print decode("MIME-Header", $_)')
            from="${from% *}"; from="${from%\"}"; from="${from#\"}"
            notify-send "📧 $from" "$subject" -i mail-message
        done
    fi
else
    notify-send "📬 mailsync" "Sync fehlgeschlagen" -i dialog-error -u critical
fi

rm -f "$LOCKFILE"
pkill -RTMIN+14 dwmblocks 2>/dev/null
