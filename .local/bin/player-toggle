#!/bin/sh
STATE="$HOME/.local/share/last-player"

mpd_playing()  { mpc status 2>/dev/null | grep -q "\[playing\]"; }
mpd_paused()   { mpc status 2>/dev/null | grep -qE "\[playing\]|\[paused\]"; }
abpl_playing() { [ "$(playerctl -p abpl status 2>/dev/null)" = "Playing" ]; }
abpl_running() { playerctl -p abpl status 2>/dev/null | grep -qE "Playing|Paused"; }
jfmp_playing() { [ "$(playerctl -p jfmp status 2>/dev/null)" = "Playing" ]; }
jfmp_running() { playerctl -p jfmp status 2>/dev/null | grep -qE "Playing|Paused"; }

browser_player() { playerctl -l 2>/dev/null | grep -Em1 "^(chromium|firefox|brave|vivaldi)"; }
browser_playing() { p=$(browser_player); [ -n "$p" ] && [ "$(playerctl -p "$p" status 2>/dev/null)" = "Playing" ]; }
browser_running() { p=$(browser_player); [ -n "$p" ] && playerctl -p "$p" status 2>/dev/null | grep -qE "Playing|Paused"; }

mpd=0; abpl=0; jfmp=0; browser=0
mpd_playing     && mpd=1
abpl_playing    && abpl=1
jfmp_playing    && jfmp=1
browser_playing && browser=1

# Alle/mehrere spielen → alle pausieren
if [ $((mpd + abpl + jfmp + browser)) -gt 1 ]; then
    [ $mpd -eq 1 ]     && mpc pause
    [ $abpl -eq 1 ]    && playerctl -p abpl pause
    [ $jfmp -eq 1 ]    && playerctl -p jfmp pause
    [ $browser -eq 1 ] && playerctl -p "$(browser_player)" pause
    exit 0
fi

# Einer spielt → den togglen
if [ $mpd -eq 1 ];     then mpc toggle;                          echo mpd     > "$STATE"; exit 0; fi
if [ $abpl -eq 1 ];    then playerctl -p abpl play-pause;        echo abpl    > "$STATE"; exit 0; fi
if [ $jfmp -eq 1 ];    then playerctl -p jfmp play-pause;        echo jfmp    > "$STATE"; exit 0; fi
if [ $browser -eq 1 ]; then playerctl -p "$(browser_player)" play-pause; echo browser > "$STATE"; exit 0; fi

# Alle pausiert: letzten getrackten Player fortsetzen
case "$(cat "$STATE" 2>/dev/null)" in
    abpl)    abpl_running    && { playerctl -p abpl play-pause;               echo abpl    > "$STATE"; exit 0; } ;;
    jfmp)    jfmp_running    && { playerctl -p jfmp play-pause;               echo jfmp    > "$STATE"; exit 0; } ;;
    browser) browser_running && { playerctl -p "$(browser_player)" play-pause; echo browser > "$STATE"; exit 0; } ;;
esac

# MPD primär
if mpd_paused; then
    mpc toggle; echo mpd > "$STATE"; exit 0
fi

notify-send "player-toggle" "Kein Player gefunden" -u low -t 2000
