#!/bin/sh
# extract - unarchive any common format

for f; do
	case "$f" in
		*.tar.bz2|*.tbz2)	tar xjf "$f" ;;
		*.tar.gz|*.tgz)	tar xzf "$f" ;;
		*.tar.xz|*.txz)	tar xJf "$f" ;;
		*.tar.zst)		tar --zstd -xf "$f" ;;
		*.tar)			tar xf "$f" ;;
		*.bz2)			bunzip2 "$f" ;;
		*.gz)			gunzip "$f" ;;
		*.xz)			unxz "$f" ;;
		*.zst)			zstd -d "$f" ;;
		*.zip)			unzip "$f" ;;
		*.7z)			7z x "$f" ;;
		*.rar)			unrar x "$f" 2>/dev/null || bsdtar xf "$f" ;;
		*.Z)			uncompress "$f" ;;
		*.deb)			ar x "$f" ;;
		*.iso)			bsdtar xf "$f" ;;
		*)			printf 'extract: %s: unrecognised format\n' "$f" >&2 ;;
	esac
done
