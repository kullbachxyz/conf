#!/bin/bash

if echo "$1" | grep -q "https*://\S\+\.[A-Za-z]\+\S*"; then
	url="$1"
else
	url="$(grep -Eom1 '<[^>]+(rel="self"|application/[a-z]+\+xml)[^>]+>' "$1" |
		grep -o "https?://[^\" ]")"

	echo "$url" | grep -q "https*://\S\+\.[A-Za-z]\+\S*" ||
		{ notify-send "That doesn't look like a full URL."; exit 1; }
fi

RSSFILE="${XDG_CONFIG_HOME:-$HOME/.config}/newsboat/urls"

# Fetch the URL — may be an HTML page or a feed directly
content="$(curl -sL --max-time 10 "$url")"

# If it's HTML, look for a linked RSS/Atom feed
if printf '%s' "$content" | grep -qi '<html'; then
	feed_url="$(printf '%s' "$content" |
		grep -i '<link[^>]*>' |
		grep -i 'alternate' |
		grep -i 'rss\|atom' |
		grep -oi 'href="[^"]*"' |
		head -1 |
		sed 's/href="//; s/"$//')"

	if [ -z "$feed_url" ]; then
		notify-send "No RSS feed found at $url"
		exit 1
	fi

	# Resolve relative URLs
	base="$(printf '%s' "$url" | grep -o 'https\?://[^/]*')"
	case "$feed_url" in
		http*) url="$feed_url" ;;
		//*) url="$(printf '%s' "$url" | grep -o 'https\?:')$feed_url" ;;
		/*) url="${base}${feed_url}" ;;
		*) url="${base}/${feed_url}" ;;
	esac

	content="$(curl -sL --max-time 10 "$url")"
fi

if awk '{print $1}' "$RSSFILE" | grep -q "^$url$"; then
	notify-send "You already have this RSS feed."
	exit 0
fi

# Extract and clean feed title
feed_title="$(printf '%s' "$content" |
	grep -m1 '<title' |
	sed 's/.*<title[^>]*>//
	     s/<\/title.*//
	     s/<!\[CDATA\[//
	     s/\]\]>//
	     s/^[[:space:]]*//
	     s/[[:space:]]*$//')"

feed_title="$(printf '%s' "$feed_title" |
	sed 's/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&#39;/'"'"'/g')"

read -e -r -i "$feed_title" -p "Title: " feed_title

if [ -n "$feed_title" ]; then
	printf '%s "~%s"\n' "$url" "$feed_title" >> "$RSSFILE"
else
	printf '%s\n' "$url" >> "$RSSFILE"
fi

notify-send "RSS feed added${feed_title:+: $feed_title}"
