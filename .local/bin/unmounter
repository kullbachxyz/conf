#!/bin/sh

export SUDO_ASKPASS="${SUDO_ASKPASS:-$HOME/.local/bin/dmenupass}"

# Unmount USB drives or Android phones. Replaces the older `dmenuumount`. Fewer
# prompt and also de-decrypts LUKS drives that are unmounted.

set -e

mounteddroids="$(grep simple-mtpfs /etc/mtab | awk '{print "📱" $2}')"
lsblkoutput="$(lsblk -nrpo "name,type,size,mountpoint")"
mounteddrives="$(echo "$lsblkoutput" | awk '($2=="part"||$2="crypt")&&$4!~/\/boot|\/home$|SWAP/&&length($4)>1{printf "💾%s (%s)\n",$4,$3}')"

allunmountable="$(echo "$mounteddroids
$mounteddrives" | sed "/^$/d;s/ *$//")"
test -n "$allunmountable"

chosen="$(echo "$allunmountable" | dmenu -i -p "Unmount which drive?")"
chosen="${chosen%% *}"
test -n "$chosen"

mountpoint="/${chosen#*/}"

# Remember block device before unmounting (empty for MTP phones).
device="$(lsblk -rno NAME,MOUNTPOINT | awk -v mp="$mountpoint" '$2==mp{print "/dev/"$1}')"

sudo -A umount -l "$mountpoint"
notify-send "Device unmounted." "$chosen has been unmounted."

# Close the chosen drive if it was a decrypted LUKS device.
cryptid="$(echo "$lsblkoutput" | grep "${mountpoint}$")"
cryptid="${cryptid%% *}"
if test -b "/dev/mapper/${cryptid##*/}"; then
    sudo -A cryptsetup close "$cryptid"
    notify-send "🔒Device encryption closed." "Drive is now securely locked again."
fi

# Power off the physical device (non-fatal, skipped for MTP phones).
if [ -n "$device" ]; then
    udisksctl power-off -b "$device" 2>/dev/null || true
fi
