! Mudita Mindful Design — LIGHT (pure monochrome: black on white)
! Reference tokens: bg #fff, fg #000, border/divider #ccc, code-bg #f2f2f2.
! Loaded via `xrdb -merge` by ~/.local/bin/theme. Consumed by st, dmenu, dwm.

! --- shared / st (neutral grayscale ramp; no color accents) ---
st.font:        IBM Plex Mono:size=12
! Selenized white (colorful — visible when the grayscale shader is OFF)
st.foreground:  #474747
st.background:  #ffffff
st.cursorColor: #474747
st.color0:      #282828
st.color1:      #d6000c
st.color2:      #1d9700
st.color3:      #c49700
st.color4:      #0064e4
st.color5:      #dd0f9d
st.color6:      #00ad9c
st.color7:      #cccccc
st.color8:      #878787
st.color9:      #bf0000
st.color10:     #008400
st.color11:     #af8500
st.color12:     #0054cf
st.color13:     #c7008b
st.color14:     #009a8a
st.color15:     #545454

! --- dwm ---
dwm.normfgcolor:     #000000
dwm.normbgcolor:     #ffffff
dwm.normbordercolor: #ffffff
dwm.selfgcolor:      #ffffff
dwm.selbgcolor:      #000000
dwm.selbordercolor:  #000000

! --- dmenu ---
dmenu.font:   IBM Plex Mono:size=12
dmenu.normfg: #000000
dmenu.normbg: #ffffff
dmenu.selfg:  #ffffff
dmenu.selbg:  #000000
dmenu.outfg:  #ffffff
dmenu.outbg:  #666666

! --- nsxiv (image viewer) ---
Nsxiv.window.background: #ffffff
Nsxiv.window.foreground: #000000
Nsxiv.bar.background:     #ffffff
Nsxiv.bar.foreground:    #000000
Nsxiv.bar.font:          IBM Plex Mono:size=12
Nsxiv.mark.foreground:   #000000
