# --- Variables ---
set $mod Mod4
set $term st
set $browser librewolf
set $menu rofi -show drun

font pango:Noto Sans Mono 13

# --- Autostart ---
exec --no-startup-id setbg
exec --no-startup-id remaps
exec --no-startup-id picom
exec --no-startup-id unclutter
exec --no-startup-id dunst
exec --no-startup-id nextcloud --background
exec_always --no-startup-id killall -q polybar; polybar
exec_always --no-startup-id killall -q autotiling; autotiling

# --- Gaps ---
gaps inner 8
gaps outer 8
smart_gaps on
smart_borders on

# --- Borders ---
default_border pixel 3
default_floating_border pixel 3

# --- Colors ---
# class                 border   backgr.  text     indicator child_border
client.focused          #770000  #005577  #eeeeee  #770000   #770000
client.unfocused        #444444  #222222  #bbbbbb  #444444   #444444
client.focused_inactive #444444  #222222  #bbbbbb  #444444   #444444
client.urgent           #770000  #770000  #eeeeee  #770000   #770000
client.background       #222222

# --- Core ---
bindsym $mod+Return exec $term
bindsym $mod+w exec $browser
bindsym $mod+space exec $menu
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+q kill
bindsym $mod+shift+x exec i3-msg exit
bindsym $mod+shift+BackSpace exec sysact
bindsym $mod+shift+c reload
bindsym $mod+shift+r restart

# --- Applications ---
bindsym $mod+e exec thunderbird
bindsym $mod+shift+e exec $term -e abook -C ~/.config/abook/abookrc --datafile ~/.config/abook/addressbook
bindsym $mod+r exec $term -e lfub
bindsym $mod+shift+n exec $term -e newsboat
bindsym $mod+shift+w exec $term -e wlctl
bindsym $mod+shift+b exec $term -e bluetui
bindsym $mod+m exec $term -e ncmpcpp
bindsym $mod+a exec $term -e abpl
bindsym $mod+u exec dmenuunicode
bindsym $mod+c exec ~/.local/bin/horizon-client
bindsym $mod+o exec ~/.local/bin/passmenu
bindsym $mod+shift+o exec keepassxc
bindsym $mod+shift+p exec $term -e podsync
bindsym $mod+shift+s exec maimpick
bindsym Print exec --no-startup-id bash -c 'maim pic-full-$(date +%y%m%d-%H%M-%S).png'

# --- Focus (vim-style, j/k up/down like dwm stack, h/l left/right added) ---
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+h focus left
bindsym $mod+l focus right

# --- Move windows ---
bindsym $mod+shift+j move down
bindsym $mod+shift+k move up
bindsym $mod+shift+h move left
bindsym $mod+shift+l move right

# --- Layout ---
bindsym $mod+shift+space floating toggle
bindsym $mod+shift+f fullscreen toggle
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+shift+a gaps inner current toggle 8; gaps outer current toggle 8
bindsym $mod+b exec polybar-msg cmd toggle
bindsym $mod+t layout splith
bindsym $mod+shift+t layout splitv
bindsym $mod+ctrl+m layout tabbed
bindsym $mod+ctrl+e layout toggle split

# --- Resize mode ---
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+ctrl+r mode "resize"

# --- Workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9

bindsym $mod+shift+1 move container to workspace $ws1
bindsym $mod+shift+2 move container to workspace $ws2
bindsym $mod+shift+3 move container to workspace $ws3
bindsym $mod+shift+4 move container to workspace $ws4
bindsym $mod+shift+5 move container to workspace $ws5
bindsym $mod+shift+6 move container to workspace $ws6
bindsym $mod+shift+7 move container to workspace $ws7
bindsym $mod+shift+8 move container to workspace $ws8
bindsym $mod+shift+9 move container to workspace $ws9

# --- Multi-monitor ---
bindsym $mod+Left focus output left
bindsym $mod+Right focus output right
bindsym $mod+shift+Left move container to output left
bindsym $mod+shift+Right move container to output right

# --- Media / Volume ---
bindsym $mod+period exec mpc next
bindsym $mod+comma exec mpc prev
bindsym $mod+p exec player-toggle
bindsym $mod+plus exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym $mod+shift+plus exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 15%+
bindsym $mod+minus exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym $mod+shift+minus exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%-
bindsym $mod+shift+m exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec player-toggle
bindsym XF86AudioPause exec player-toggle
bindsym XF86MonBrightnessDown exec brightnessctl set 10-
bindsym XF86MonBrightnessUp exec brightnessctl set 10+

# --- Function Keys ---
bindsym $mod+F3 exec displayselect
bindsym $mod+F4 exec $term -e pulsemixer
bindsym $mod+F8 exec mailsync
bindsym $mod+F9 exec mounter
bindsym $mod+F10 exec unmounter
bindsym $mod+F11 exec ~/.local/bin/webcam
bindsym $mod+F12 exec remaps

# --- Scratchpad ---
for_window [title="scratchpad-st"] move scratchpad, resize set 800 500
bindcode $mod+21 exec ~/.local/bin/scratchpad-toggle

# --- Window Rules ---
for_window [class="Gimp"] floating enable
for_window [class="LibreWolf"] move to workspace $ws9

# --- Floating drag modifier ---
floating_modifier $mod
