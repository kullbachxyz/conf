# ~/.config/zathura/zathurarc

# General UI
set window-title-basename true
set selection-clipboard clipboard
set statusbar-home-tilde true
set guioptions s

# Font
set font "Lato 11"

# Page layout
set adjust-open width
set pages-per-row 1
set first-page-column 1:1
set vertical-center true
set scroll-page-aware true
set scroll-full-overlap 0.01
set zoom-center true
set link-zoom true

# Smooth-ish navigation
set scroll-step 80
set scroll-hstep 80
set zoom-step 10

# Search
set search-hadjust true
set incremental-search true

# Theme colors (MMD dark: white-on-black)
set default-bg              "#000000"
set default-fg              "#ffffff"
set statusbar-bg           "#000000"
set statusbar-fg           "#ffffff"
set inputbar-bg            "#000000"
set inputbar-fg           "#ffffff"
set completion-bg          "#000000"
set completion-fg          "#ffffff"
set completion-highlight-bg "#ffffff"
set completion-highlight-fg "#000000"
set highlight-color        "#cccccc"
set highlight-active-color "#999999"

# Recolor PDFs (dark mode inverts: paper->bg, ink->fg). Toggle: Ctrl+r or i
set recolor                true
set recolor-keephue        true
set recolor-reverse-video  false
set recolor-lightcolor     "#000000"
set recolor-darkcolor      "#ffffff"


# Good extra mappings
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print
map <C-p> print
map D toggle_page_mode
map <C-b> scroll half-up
map <C-f> scroll half-down
