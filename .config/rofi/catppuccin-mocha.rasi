* {
  rosewater: #f5e0dc;
  flamingo: #f2cdcd;
  pink: #f5c2e7;
  mauve: #cba6f7;
  red: #f38ba8;
  maroon: #eba0ac;
  peach: #fab387;
  yellow: #f9e2af;
  green: #a6e3a1;
  teal: #94e2d5;
  sky: #89dceb;
  sapphire: #74c7ec;
  blue: #89b4fa;
  lavender: #b4befe;
  text: #cdd6f4;
  subtext1: #bac2de;
  subtext0: #a6adc8;
  overlay2: #9399b2;
  overlay1: #7f849c;
  overlay0: #6c7086;
  surface2: #585b70;
  surface1: #45475ab3;
  surface0: #313244b3;
  base: #1e1e2ed9;
  mantle: #181825d9;
  crust: #11111b;

  background: @base;
  background-alt: @surface0;
  foreground: @text;
  muted: @subtext0;
  selected: @surface1;
  selected-foreground: @text;
  urgent: @red;
  active: @green;
  border-color: @surface1;
  transparent: #00000000;
}

window {
  width: 42em;
  border: 1px;
  border-color: @border-color;
  border-radius: 0;
  background-color: @background;
  padding: 0;
}

mainbox {
  background-color: @transparent;
  children: [inputbar, listview];
  spacing: 0;
  padding: 0;
}

inputbar {
  background-color: @mantle;
  border: 0px;
  border-color: @surface0;
  border-radius: 0;
  padding: 0.75em 1em;
  spacing: 0.6em;
  children: [entry];
}

entry {
  background-color: @transparent;
  text-color: @foreground;
  placeholder-color: @muted;
}

listview {
  background-color: @transparent;
  margin: 0;
  padding: 0.4em 0;
  lines: 6;
  spacing: 0;
  fixed-height: true;
  dynamic: false;
  scrollbar: false;
}

element {
  background-color: @transparent;
  border-radius: 0;
  padding: 0.35em 0.75em;
  margin: 0 0.4em;
  spacing: 0.55em;
}

element normal.normal {
  background-color: @transparent;
  text-color: @foreground;
}

element alternate.normal {
  background-color: @transparent;
  text-color: @foreground;
}

element selected.normal {
  background-color: @selected;
  text-color: @selected-foreground;
  border-radius: 0;
}

element normal.urgent {
  background-color: @transparent;
  text-color: @foreground;
}

element alternate.urgent {
  background-color: @transparent;
  text-color: @foreground;
}

element selected.urgent {
  background-color: @selected;
  text-color: @selected-foreground;
}

element normal.active {
  background-color: @transparent;
  text-color: @foreground;
}

element alternate.active {
  background-color: @transparent;
  text-color: @foreground;
}

element selected.active {
  background-color: @selected;
  text-color: @selected-foreground;
}

element-icon {
  size: 1.4em;
  background-color: @transparent;
  text-color: @foreground;
}

element-text {
  background-color: @transparent;
  text-color: @foreground;
  vertical-align: 0.5;
}

element selected element-icon,
element selected element-text {
  text-color: @selected-foreground;
}

message {
  background-color: @mantle;
  border: 1px;
  border-color: @surface0;
  border-radius: 0;
  margin: 0.35em 0 0 0;
  padding: 0.5em;
}

textbox {
  background-color: @transparent;
  text-color: @foreground;
}
