/* Mudita Mindful Design — DARK (white on black, sharp edges, inverted selection) */
* {
    bg:       #000000;
    fg:       #ffffff;
    border-c: #444444;
    sel-bg:   #ffffff;
    sel-fg:   #000000;
    muted:    #b0b0b0;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           3px;
    border-color:     @fg;
    border-radius:    0px;
    width:            40%;
    padding:          10px;
}

mainbox {
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg;
    text-color:       @fg;
    border:           0px 0px 1px 0px;
    border-color:     @border-c;
    padding:          0px 0px 8px 0px;
    spacing:          8px;
    children:         [ entry ];
}

prompt { text-color: @fg; }
entry  { text-color: @fg; placeholder: "Suchen"; placeholder-color: @muted; }

listview {
    background-color: @bg;
    lines:            8;
    scrollbar:        false;
    spacing:          2px;
}

element {
    background-color: @bg;
    text-color:       @fg;
    border-radius:    0px;
    padding:          6px 8px;
}
element selected {
    background-color: @sel-bg;
    text-color:       @sel-fg;
}
element-text { background-color: transparent; text-color: inherit; }
element-icon { background-color: transparent; size: 1.0em; }
