configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    terminal: "st";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    case-sensitive: false;
    cycle: false;
    sidebar-mode: false;
    fullscreen: false;
    hide-scrollbar: true;
    lines: 4;
    columns: 1;
    location: 0;
    yoffset: 0;
    xoffset: 0;
    font: "Iosevka Nerd Font Propo 12";
}

@theme "~/.config/rofi/dark.rasi"
