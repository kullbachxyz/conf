[global]
monitor = 0
follow = keyboard
width = (0, 512)
height = (0, 315)
frame_width = 3
offset = (10, 33)
padding = 15
horizontal_padding = 15
transparency = 0
font = Iosevka Nerd Font Propo 13
format = "<b>%s</b>\n%b"

[urgency_low]
background = "#1c1c1c"
foreground = "#d8d8d8"
frame_color = "#555555"
timeout = 3

[urgency_normal]
background = "#1c1c1c"
foreground = "#d8d8d8"
frame_color = "#888888"
timeout = 5

[urgency_critical]
background = "#1c1c1c"
foreground = "#d8d8d8"
frame_color = "#cc4444"
timeout = 10
