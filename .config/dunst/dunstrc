[global]
monitor = 0
follow = keyboard
width = (0, 512)
height = (0, 315)
frame_width = 3
offset = (20, 43)
padding = 15
horizontal_padding = 15
transparency = 0
font = Adwaita Mono 13
format = "<b>%s</b>\n%b"

[urgency_low]
background = "#000000"
foreground = "#ffffff"
frame_color = "#ffffff"
timeout = 3

[urgency_normal]
background = "#000000"
foreground = "#ffffff"
frame_color = "#ffffff"
timeout = 5

[urgency_critical]
background = "#000000"
foreground = "#ffffff"
frame_color = "#ffffff"
timeout = 10
