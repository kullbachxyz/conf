[global]
monitor = 0
follow = keyboard
width = (0, 512)
height = (0, 315)
frame_width = 3
offset = (10, 33)
padding = 15
horizontal_padding = 15
transparency = 0
font = Iosevka Nerd Font Propo 11
format = "<b>%s</b>\n%b"

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#94e2d5"
timeout = 3

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#cdd6f4"
timeout = 5

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
timeout = 10
