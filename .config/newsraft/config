# Migrated from Newsboat on 2026-05-05
# Mutt-like presentation.
scrolloff 5
menu-item-sorting time-publication-desc
list-entry-date-format "%y/%m/%d %I:%M%p"
menu-feed-sorting none
status-show-menu-path true
feeds-menu-paramount-explore true

menu-feed-entry-format "%5.0u │ %t"
menu-item-entry-format "%u │ %D │ %T │ %o"
menu-explore-item-entry-format "%u │ %D │ %T │ %o"

color-status white black
color-status-info cyan black
color-status-fail red black bold
color-list-item default default
color-list-item-selected default black bold
color-list-item-unread blue default bold
color-list-item-important green default bold
color-list-feed magenta default
color-list-feed-selected magenta black bold
color-list-feed-unread magenta default bold
color-list-feed-failed red default
color-list-section white default bold
color-list-section-selected white black bold
color-list-section-unread white default bold
color-list-section-failed red default
