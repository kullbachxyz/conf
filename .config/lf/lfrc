# Basic settings
set icons
set cleaner '~/.config/lf/cleaner'
set previewer '~/.config/lf/scope'

# Commands
cmd mkdir $mkdir -p "$@"

# Bindings
cmd open $linkhandler "$f"
map c cut
map H cd ~
map gh cd /home/ph
map o open
map e $$EDITOR "$f"
map D delete
map gg top
map G bottom
map gw cd ~/pics/walls
map gm cd /mnt
map zh set hidden!
map zr set reverse!
map X $extract "$fx" && lf -remote "send $id reload"
map bg $setbg "$f"
